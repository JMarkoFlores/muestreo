# Copia a .env para entorno local. Nunca publiques secretos reales.
POSTGRES_DB=soc_lite
POSTGRES_USER=soc_lite
POSTGRES_PASSWORD=soc_lite_local_only
JWT_SECRET=cambia-por-una-clave-local-larga
SERVICE_API_KEY=soc-lite-service-local
BACKEND_PORT=8000
FRONTEND_PORT=5173
N8N_PORT=5678
N8N_BASIC_AUTH_ACTIVE=true
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=soc-lite-n8n-local
DEMO_MODE=true
USE_OLLAMA=false
OLLAMA_MODEL=llama3.2:3b
OLLAMA_BASE_URL=http://ollama:11434
ENABLE_EXTERNAL_ENRICHMENT=false
VIRUSTOTAL_API_KEY=
ABUSEIPDB_API_KEY=
GEOIP_PROVIDER=simulado
